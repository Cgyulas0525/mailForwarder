APP_NAME=mailForwarder
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:28090
APP_TIMEZONE=Europe/Budapest

APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mailforwarder
DB_USERNAME=mailforwarder
DB_PASSWORD=mailforwarder_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=120

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Üres = a teljes nap. Az admin felület felülírhatja. Ne rögzíts üzleti időt ide.
MAIL_CHECK_START=
MAIL_CHECK_END=
MAIL_SYNC_BATCH_SIZE=40
MAIL_SYNC_MAX_PER_RUN=200
MAIL_SYNC_OVERLAP=25
FORWARD_MAX_ATTACHMENT_BYTES=10485760
MESSAGE_RETENTION_DAYS=90

# Fejlesztésben false: minden kimenő levél a Mailpitre megy.
FORWARD_LIVE_SMTP=false
FORWARD_CAPTURE_DSN=smtp://mailpit:1025

# gmail-evaluator MySQL — csak a GmailAccountsSeeder és a UsersSeeder.
# Konténerből: host.docker.internal és a host port (23306), ne a saját mysql:3306.
LEGACY_DB_HOST=host.docker.internal
LEGACY_DB_PORT=23306
LEGACY_DB_DATABASE=gmail_eval
LEGACY_DB_USERNAME=gmail_user
LEGACY_DB_PASSWORD=gmail_password
# A gmail-evaluator APP_KEY. Nem helyettesíti ennek az alkalmazásnak a kulcsát.
LEGACY_APP_KEY=
LEGACY_IMPORT_TEST_CONNECTIONS=true

VITE_APP_NAME="${APP_NAME}"
